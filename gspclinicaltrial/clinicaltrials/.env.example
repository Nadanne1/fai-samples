# Copy to .env and set HEALTHLAKE_DATASTORE_ID — that is the only required value.
# All other values have working defaults.

HEALTHLAKE_DATASTORE_ID=

# Optional — AWS region (defaults to us-east-1)
# AWS_REGION=us-east-1

# Optional — only needed when deploying AgentCore MCP gateway
# CLINICAL_TRIALS_API_KEY=
